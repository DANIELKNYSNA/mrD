{
  "name": "mrd-search",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "check": "npm run typecheck -w backend && npm run check -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
