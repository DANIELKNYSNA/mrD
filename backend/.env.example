PORT=3000
CORS_ORIGIN=http://localhost:5173

# Simulated upstream provider behaviour (rates are probabilities between 0 and 1)
UPSTREAM_MIN_LATENCY_MS=80
UPSTREAM_MAX_LATENCY_MS=600
UPSTREAM_SLOW_RATE=0.1
UPSTREAM_SLOW_LATENCY_MS=2500
UPSTREAM_FAILURE_RATE=0.1

# How long search waits for each item's offer before returning it without a price
UPSTREAM_TIMEOUT_MS=1000

# How long a successful upstream offer is reused, in ms (0 disables the cache)
OFFER_CACHE_TTL_MS=30000
